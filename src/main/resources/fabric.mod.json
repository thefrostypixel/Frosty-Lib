{
    "schemaVersion": 1,
    "id": "frosty-lib",
    "version": "${version}",
    "name": "Frosty Lib",
    "description": "A library to simplify creating UIs such as config screens.",
    "authors": ["thefrostypixel"],
    "contact": {
        "homepage": "https://github.com/thefrostypixel/Frosty-Lib",
        "sources": "https://github.com/thefrostypixel/Frosty-Lib",
        "issues": "https://github.com/thefrostypixel/Frosty-Lib/issues?q=is%3Aissue"
    },
    "license": "CC0-1.0",
    "icon": "assets/frosty-lib/icon.png",
    "environment": "client",
    "depends": {
        "minecraft": "${minecraft.range}",
        "fabricloader": "${fabricLoader.range}",
        "fabric-api": "${fabricApi.range}"
    },
    "custom": {
        "modmenu": {
            "badges": ["library"]
        }
    }
}
